{
  "Comment": "P1 incident escalation workflow",
  "QueryLanguage": "JSONPath",
  "StartAt": "WaitForAcknowledgment",
  "States": {
    "WaitForAcknowledgment": {
      "Type": "Wait",
      "Seconds": 300,
      "Next": "GetIncidentStatus"
    },
    "GetIncidentStatus": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:getItem",
      "Parameters": {
        "TableName": "cloudops-dev-incidents",
        "Key": {
          "incidentId": {
            "S.$": "$.incidentId"
          }
        }
      },
      "ResultPath": "$.incidentRecord",
      "Next": "IsAcknowledged"
    },
    "IsAcknowledged": {
      "Type": "Choice",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.incidentRecord.Item.acknowledged.BOOL",
              "IsPresent": true
            },
            {
              "Variable": "$.incidentRecord.Item.acknowledged.BOOL",
              "BooleanEquals": true
            }
          ],
          "Next": "NoEscalationNeeded"
        }
      ],
      "Default": "EscalateViaSNS"
    },
    "NoEscalationNeeded": {
      "Type": "Succeed"
    },
    "EscalateViaSNS": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "arn:aws:sns:eu-west-2:845261682900:cloudops-dev-p1-escalation",
        "Message.$": "States.Format('ESCALATION: Incident {} ({}) at {} was not acknowledged within 5 minutes and requires immediate attention.', $.incidentId, $.title, $.location)",
        "Subject": "P1 Incident Escalation - Action Required"
      },
      "End": true
    }
  }
}
